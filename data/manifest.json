{
  "tables": [
    {
      "file": "segments.csv",
      "columns": [
        "segment_id",
        "course_version",
        "position",
        "duration_min",
        "title"
      ],
      "key": "segment_id"
    },
    {
      "file": "topics.csv",
      "columns": [
        "topic_id",
        "label",
        "period",
        "required"
      ],
      "key": "topic_id"
    },
    {
      "file": "segment_topics.csv",
      "columns": [
        "segment_id",
        "topic_id",
        "relation",
        "valid_from",
        "valid_to"
      ],
      "unique_keys": [
        [
          "segment_id",
          "topic_id",
          "valid_from"
        ]
      ]
    },
    {
      "file": "references.csv",
      "columns": [
        "reference_id",
        "segment_id",
        "source_id",
        "claim_topic",
        "course_version"
      ],
      "key": "reference_id"
    },
    {
      "file": "sources.csv",
      "columns": [
        "source_id",
        "object_token",
        "source_note",
        "review_status",
        "available_from",
        "available_to"
      ],
      "key": "source_id"
    },
    {
      "file": "feedback.csv",
      "columns": [
        "session_id",
        "segment_id",
        "topic_id",
        "understood_count",
        "respondent_count"
      ],
      "unique_keys": [
        [
          "session_id",
          "segment_id",
          "topic_id"
        ]
      ]
    }
  ],
  "optional_tables": [
    "sessions.csv",
    "segment_lineage.csv",
    "source_profiles.csv",
    "adopted_recommendations.csv",
    "recommendations.csv"
  ]
}
